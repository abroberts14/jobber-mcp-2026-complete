# Jobber MCP Server configuration
#
# Jobber does NOT issue static API keys/tokens. Authentication is OAuth 2.0:
# a client ID/secret identify your app, and a refresh token (obtained once via
# `npm run authorize`) is exchanged for a 60-minute access token as needed.
#
# Copy to .env and fill in.

# --- Required: from your app at https://developer.getjobber.com ---
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=

# --- Required: produced by `npm run authorize` ---
# Jobber rotates this on every refresh. The server persists the current value to
# JOBBER_TOKEN_STORE, so this only needs to be valid for the very first run.
JOBBER_REFRESH_TOKEN=

# --- Optional ---
# Must exactly match a redirect URI registered on your Jobber app. Only used by
# `npm run authorize`.
JOBBER_REDIRECT_URI=http://localhost:3000/callback

# Local port the authorize CLI listens on for the redirect. Inferred from a
# loopback JOBBER_REDIRECT_URI; set it explicitly when the redirect goes through
# a tunnel (ngrok etc) so the code is still captured automatically. Leave blank
# with a non-loopback URI and the CLI asks you to paste the code instead.
JOBBER_CALLBACK_PORT=

# Skip the first refresh by supplying an access token you already hold.
JOBBER_ACCESS_TOKEN=

# Where rotated tokens are cached. Defaults to ~/.jobber-mcp/tokens.json
JOBBER_TOKEN_STORE=

# API overrides — leave blank unless you have a reason.
JOBBER_API_URL=https://api.getjobber.com/api/graphql
JOBBER_OAUTH_URL=https://api.getjobber.com/api/oauth
JOBBER_GRAPHQL_VERSION=2025-01-20

# --- HTTP transport (dist/http.js) — only needed when hosting for a team ---
# Shared bearer secret. The server refuses to start without it: the tool set can
# mutate your Jobber account. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOBBER_MCP_SECRET=

# Endpoint path and listen port.
JOBBER_MCP_PATH=/mcp
PORT=3000
